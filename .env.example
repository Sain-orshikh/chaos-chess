# Existing Express / MongoDB backend
MONGODB_URI=mongodb://127.0.0.1:27017/chaos-chess
# Generate a random secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Local development only. Vercel Services routes /api directly to Express.
API_BACKEND_URL=http://127.0.0.1:5000

# Required only for profile picture uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: trusted reverse-proxy IPs/CIDRs (not an arbitrary number of hops).
# Enable only behind a proxy that replaces client-supplied forwarding headers.
# TRUST_PROXY=loopback

# Optional structured log verbosity. Vercel captures stdout/stderr in Runtime Logs.
LOG_LEVEL=info
